{
	"compilerOptions": {
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"module": "esnext",
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"target": "esnext",
		"lib": ["ESNext", "ES2022", "ES5", "ES6"],
		"resolveJsonModule": true,
		"isolatedModules": true,
		"alwaysStrict": true
	},
	"include": ["src/**/*", "scripts/**/*", "*.ts"],
	"exclude": ["node_modules"]
}
